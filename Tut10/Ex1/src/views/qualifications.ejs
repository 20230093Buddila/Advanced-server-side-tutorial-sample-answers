<%- include('partials/header') %>

<div class="container wide-container">
    <div class="card">
        <h2>My Qualifications</h2>
        
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>
        
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>
        
        <h3 style="margin: 1.5rem 0 1rem; color: #333;">Add New Qualification</h3>
        
        <form action="/qualifications" method="POST">
            <div class="grid-2">
                <div class="form-group">
                    <label for="q_type">Type</label>
                    <select id="q_type" name="q_type" required>
                        <option value="">Select type...</option>
                        <option value="degree">Degree</option>
                        <option value="certification">Certification</option>
                        <option value="licence">Licence</option>
                        <option value="course">Course</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="title">Title</label>
                    <input type="text" id="title" name="title" placeholder="e.g., BSc Computer Science" required>
                </div>
            </div>
            
            <div class="grid-2">
                <div class="form-group">
                    <label for="organization">Organization</label>
                    <input type="text" id="organization" name="organization" placeholder="e.g., University of Westminster">
                </div>
                
                <div class="form-group">
                    <label for="completion_date">Completion Date</label>
                    <input type="date" id="completion_date" name="completion_date">
                </div>
            </div>
            
            <div class="form-group">
                <label for="url">Certificate URL (optional)</label>
                <input type="url" id="url" name="url" placeholder="https://...">
            </div>
            
            <button type="submit" class="btn">Add Qualification</button>
        </form>
        
        <hr style="margin: 2rem 0; border: none; border-top: 1px solid #e0e0e0;">
        
        <h3 style="margin-bottom: 1rem; color: #333;">Your Qualifications</h3>
        
        <% if (qualifications && qualifications.length > 0) { %>
            <% qualifications.forEach(qual => { %>
                <div class="qualification-card">
                    <h4><%= qual.title %></h4>
                    <p><strong>Type:</strong> <%= qual.q_type.charAt(0).toUpperCase() + qual.q_type.slice(1) %></p>
                    <% if (qual.organization) { %>
                        <p><strong>Organization:</strong> <%= qual.organization %></p>
                    <% } %>
                    <% if (qual.completion_date) { %>
                        <p><strong>Completed:</strong> <%= new Date(qual.completion_date).toLocaleDateString() %></p>
                    <% } %>
                    <% if (qual.url) { %>
                        <p><a href="<%= qual.url %>" target="_blank">View Certificate →</a></p>
                    <% } %>
                    <div class="qualification-actions">
                        <a href="/qualifications/edit/<%= qual.id %>" class="btn btn-small btn-secondary">Edit</a>
                        <form action="/qualifications/delete/<%= qual.id %>" method="POST" style="display: inline;">
                            <button type="submit" class="btn btn-small btn-danger" onclick="return confirm('Are you sure you want to delete this qualification?')">Delete</button>
                        </form>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <p style="color: #666; text-align: center;">No qualifications added yet.</p>
        <% } %>
        
        <p class="link-text" style="margin-top: 2rem;">
            <a href="/profile">← Back to Profile</a>
        </p>
    </div>
</div>

<%- include('partials/footer') %>
