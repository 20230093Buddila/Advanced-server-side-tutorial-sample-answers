<%- include('partials/header') %>

<div class="container wide-container">
    <div class="card">
        <h2>Alumni Profile</h2>
        
        <div class="alumni-profile-section">
            <div class="alumni-header">
                <% if (profile && profile.image_url) { %>
                    <img src="<%= profile.image_url %>" alt="Profile Image" class="alumni-image">
                <% } else { %>
                    <img src="https://via.placeholder.com/150?text=No+Image" alt="No Image" class="alumni-image">
                <% } %>
                
                <div class="alumni-info">
                    <h3><%= email %></h3>
                    
                    <% if (profile && profile.biography) { %>
                        <p class="alumni-bio"><%= profile.biography %></p>
                    <% } %>
                    
                    <% if (profile && profile.linkedin_url) { %>
                        <a href="<%= profile.linkedin_url %>" target="_blank" class="linkedin-link">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#0077b5">
                                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                            </svg>
                            View LinkedIn Profile
                        </a>
                    <% } else { %>
                        <p class="no-linkedin">No LinkedIn profile linked</p>
                    <% } %>
                </div>
            </div>
        </div>
        
        <hr style="margin: 2rem 0; border: none; border-top: 1px solid #e0e0e0;">
        
        <h3 style="margin-bottom: 1.5rem; color: #333;">Qualifications</h3>
        
        <% if (qualifications && qualifications.length > 0) { %>
            <div class="qualifications-grid">
                <% qualifications.forEach(qual => { %>
                    <div class="qualification-card">
                        <div class="qual-type-badge <%= qual.q_type %>">
                            <%= qual.q_type.charAt(0).toUpperCase() + qual.q_type.slice(1) %>
                        </div>
                        <h4><%= qual.title %></h4>
                        <% if (qual.organization) { %>
                            <p class="qual-org"><%= qual.organization %></p>
                        <% } %>
                        <% if (qual.completion_date) { %>
                            <p class="qual-date">Completed: <%= new Date(qual.completion_date).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }) %></p>
                        <% } %>
                        <% if (qual.url) { %>
                            <a href="<%= qual.url %>" target="_blank" class="cert-link">View Certificate →</a>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="no-quals">
                <p>No qualifications added yet.</p>
                <a href="/qualifications" class="btn btn-small">Add Qualifications</a>
            </div>
        <% } %>
        
        <p class="link-text" style="margin-top: 2rem;">
            <a href="/profile">Edit Profile →</a>
        </p>
    </div>
</div>

<style>
    .alumni-profile-section {
        margin-bottom: 1.5rem;
    }
    .alumni-header {
        display: flex;
        align-items: flex-start;
        gap: 2rem;
    }
    .alumni-image {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #667eea;
        flex-shrink: 0;
    }
    .alumni-info {
        flex: 1;
    }
    .alumni-info h3 {
        color: #333;
        margin-bottom: 0.75rem;
        font-size: 1.25rem;
    }
    .alumni-bio {
        color: #666;
        line-height: 1.6;
        margin-bottom: 1rem;
    }
    .linkedin-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #0077b5;
        text-decoration: none;
        font-weight: 500;
        padding: 0.5rem 1rem;
        background: #e8f4f8;
        border-radius: 8px;
        transition: background 0.3s;
    }
    .linkedin-link:hover {
        background: #d0e8f0;
    }
    .no-linkedin {
        color: #999;
        font-style: italic;
    }
    .qualifications-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1rem;
    }
    .qualification-card {
        position: relative;
        padding-top: 2.5rem;
    }
    .qual-type-badge {
        position: absolute;
        top: 0;
        left: 1rem;
        padding: 0.25rem 0.75rem;
        border-radius: 0 0 8px 8px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        color: white;
    }
    .qual-type-badge.degree { background: #667eea; }
    .qual-type-badge.certification { background: #28a745; }
    .qual-type-badge.licence { background: #fd7e14; }
    .qual-type-badge.course { background: #17a2b8; }
    .qual-org {
        color: #555;
        font-weight: 500;
    }
    .qual-date {
        color: #888;
        font-size: 0.875rem;
    }
    .cert-link {
        color: #667eea;
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
    }
    .cert-link:hover {
        text-decoration: underline;
    }
    .no-quals {
        text-align: center;
        padding: 2rem;
        color: #666;
        background: #f8f9fa;
        border-radius: 10px;
    }
    .no-quals p {
        margin-bottom: 1rem;
    }
    .no-quals .btn {
        display: inline-block;
        width: auto;
        margin-top: 0.5rem;
    }
    
    @media (max-width: 600px) {
        .alumni-header {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }
    }
</style>

<%- include('partials/footer') %>
