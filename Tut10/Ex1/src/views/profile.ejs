<%- include('partials/header') %>

<div class="container wide-container">
    <div class="card">
        <h2>My Profile</h2>
        
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>
        
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>
        
        <% if (profile && profile.image_url) { %>
            <img src="<%= profile.image_url %>" alt="Profile Image" class="profile-image">
        <% } else { %>
            <img src="https://via.placeholder.com/120?text=No+Image" alt="No Image" class="profile-image">
        <% } %>
        
        <form action="/profile/upload-image" method="POST" enctype="multipart/form-data" style="text-align: center; margin-bottom: 1.5rem;">
            <input type="file" name="image" accept="image/*" required style="margin-bottom: 0.5rem;">
            <button type="submit" class="btn btn-small btn-secondary">Upload Image</button>
        </form>
        
        <hr style="margin: 1.5rem 0; border: none; border-top: 1px solid #e0e0e0;">
        
        <form action="/profile/update" method="POST">
            <div class="form-group">
                <label for="biography">Biography</label>
                <textarea id="biography" name="biography" rows="4" placeholder="Tell us about yourself..."><%= profile && profile.biography ? profile.biography : '' %></textarea>
            </div>
            
            <div class="form-group">
                <label for="linkedin_url">LinkedIn Profile URL</label>
                <input type="url" id="linkedin_url" name="linkedin_url" placeholder="https://linkedin.com/in/yourprofile" value="<%= profile && profile.linkedin_url ? profile.linkedin_url : '' %>">
            </div>
            
            <button type="submit" class="btn">Update Profile</button>
        </form>
        
        <hr style="margin: 1.5rem 0; border: none; border-top: 1px solid #e0e0e0;">
        
        <p class="link-text">
            <a href="/qualifications">Manage Qualifications →</a>
        </p>
    </div>
</div>

<%- include('partials/footer') %>
